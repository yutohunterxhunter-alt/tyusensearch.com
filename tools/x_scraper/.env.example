# XのCookie（ブラウザのdevtoolsから取得）
# 取得方法: Xにログイン → F12 → Application → Cookies → twitter.com
X_AUTH_TOKEN=ここにauth_tokenの値を貼る
X_CT0=ここにct0の値を貼る

# Gemini API
GEMINI_API_KEY=ここにGeminiのAPIキーを貼る

# WordPress
WP_SITE_URL=https://tyusensearch.com
WP_USERNAME=WordPressのユーザー名
WP_APP_PASSWORD=WordPress管理画面で生成したアプリパスワード
